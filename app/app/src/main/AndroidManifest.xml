<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="de.tu_darmstadt.seemoo.nexmon">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="23" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Get permission for reliable local dispatching on non-Google Play devices. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Signature-level permission used to gate the app's internal control
         broadcasts (start/stop attacks, monitor-mode transitions, service
         state). Only apps signed with the same key can hold it, so another
         installed app can neither inject these broadcasts nor receive them. -->
    <permission
        android:name="de.tu_darmstadt.seemoo.nexmon.permission.INTERNAL_BROADCAST"
        android:protectionLevel="signature" />
    <uses-permission android:name="de.tu_darmstadt.seemoo.nexmon.permission.INTERNAL_BROADCAST" />

    <application
        android:name="de.tu_darmstadt.seemoo.nexmon.MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/x_logo"
        android:label="@string/app_name"
        tools:replace="android:theme"
        android:theme="@android:style/Theme.Material"
        android:largeHeap="true">
        <activity
            android:name="de.tu_darmstadt.seemoo.nexmon.gui.MyActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="de.tu_darmstadt.seemoo.nexmon.gui.AttackInfoActivity"
            android:label="Attack Info"
            android:launchMode="standard">
        </activity>

        <activity
            android:name="de.tu_darmstadt.seemoo.nexmon.gui.SurveyNotificationActivity"
            android:launchMode="standard">
        </activity>

        <activity
            android:name="com.nononsenseapps.filepicker.FilePickerActivity"
            android:label="@string/app_name"
            android:theme="@style/FilePickerTheme">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>




        <service android:name="de.tu_darmstadt.seemoo.nexmon.sharky.WiresharkService" />
        <service android:name="de.tu_darmstadt.seemoo.nexmon.stations.APfinderService" />
        <service android:name="de.tu_darmstadt.seemoo.nexmon.stations.AttackService" />
        <service android:name="de.tu_darmstadt.seemoo.nexmon.net.RawSocketReceiveService"/>
        <service android:name="de.tu_darmstadt.seemoo.nexmon.net.MonitorModeService"/>

        <!-- Not exported: this receiver overwrites the global attack
             rate-limit map from int extras, so it must not be reachable by
             other apps. Same-app broadcasts still reach a non-exported
             receiver. -->
        <receiver
            android:name="de.tu_darmstadt.seemoo.nexmon.stations.AttackInstanceReceiver"
            android:enabled="true"
            android:exported="false"
            android:permission="de.tu_darmstadt.seemoo.nexmon.permission.INTERNAL_BROADCAST">
            <intent-filter>
                <action android:name="de.tu_darmstadt.seemoo.nexmon.ATTACK_INSTANCES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
