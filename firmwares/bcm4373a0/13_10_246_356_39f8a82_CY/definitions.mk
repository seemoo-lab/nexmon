NEXMON_CHIP=CHIP_VER_BCM4373a0
NEXMON_CHIP_NUM=`$(NEXMON_ROOT)/buildtools/scripts/getdefine.sh $(NEXMON_CHIP)`
NEXMON_FW_VERSION=FW_VER_13_10_246_356_39f8a82_CY
NEXMON_FW_VERSION_NUM=`$(NEXMON_ROOT)/buildtools/scripts/getdefine.sh $(NEXMON_FW_VERSION)`

NEXMON_ARCH=armv7-r

FW_FILE=brcmfmac4373-usb-sa-prod_v13.10.246.356.bin
RAM_FILE_OFFSET=0x24
RAM_FILE_LEN=0x8cf38

RAM_FILE=brcmfmac4373-ram.bin
RAMSTART=0x160800 # 0x160000 but the fw ram image is loaded to 0x160800
RAMSIZE=0xdf800 # 0xe0000 but substract offset of 0x800

ROM_FILE=rom.bin
#ROMSTART=0x0
#ROMSIZE=0xe0000
ROMSTART=0xe248
ROMSIZE=0x0cd18c

UCODESTART=0x1DD8A0
UCODESIZE=0xED00
UCODESTART_PTR=0x1CF2D0
UCODESIZE_PTR=0x1CF2CC
WLC_UCODE_WRITE_BL_HOOK_ADDR=0x1CF2B4

HNDRTE_RECLAIM_3_END_PTR=0x183300
HNDRTE_RECLAIM_3_ORIG_END=0x1ED5B4

TEMPLATERAMSTART_PTR=0x1CB5DC
TEMPLATERAMSTART=0x1EC5A4
TEMPLATERAMSIZE=0x1010

## rom patches
FP_DATA_BASE=0x162000
FP_DATA_END=0x163000
FP_DATA_LAST_PTR=0x1CAAD4
FP_CONFIG_ORIGBASE=0x163000
FP_CONFIG_ORIGEND=0x163708
# hnd_tcam_load_default
FP_CONFIG_BASE_PTR_1=0x1C4D50
FP_CONFIG_END_PTR_1=0x1C4D4C
# hnd_tcam_verify
FP_CONFIG_BASE_PTR_2=0x1C4BBC
FP_CONFIG_END_PTR_2=0x1C4BC0
# hnd_tcam_stat
FP_CONFIG_BASE_PTR_3=0x1C4C94
FP_CONFIG_END_PTR_3=0x1C4C90
# hnd_tcam_reclaim
FP_CONFIG_BASE_PTR_4=$(FP_CONFIG_BASE_PTR_3)
FP_CONFIG_END_PTR_4=$(FP_CONFIG_END_PTR_3)

N_EXTRA_FP=31
FP_CONFIG_SIZE=$$(($(FP_CONFIG_ORIGEND) - $(FP_CONFIG_ORIGBASE) + 8 * $(N_EXTRA_FP)))
FP_CONFIG_BASE=$$(($(HNDRTE_RECLAIM_3_ORIG_END) - $(FP_CONFIG_SIZE)))

PATCHSIZE=0x2000
PATCHSTART=$$(($(FP_CONFIG_BASE) - $(PATCHSIZE)))

VERSION_PTR_1=0x186B2C
VERSION_PTR_2=0x1CAD54
VERSION_PTR_3=0x1CBAAC
VERSION_PTR_4=0x1CA0D4
DATE_PTR=0x186B38
TIME_PTR=0x186B28
