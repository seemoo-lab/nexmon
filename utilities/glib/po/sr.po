#: gio/gappinfo.c:376
msgid "Setting default applications not supported yet"
msgstr "Подешавање подразумеваних програма још није подржано"

#: gio/gappinfo.c:408
msgid "Setting application as last used for type not supported yet"
msgstr "Подешавање програма као последњег коришћеног за врсту још није подржано"

#: gio/gappinfo.c:595
#, c-format
msgid "Invalid file extension ‘%s’"
msgstr "Неисправно проширење датотеке „%s“"

#: gio/gappinfo.c:1011
#, c-format
msgid "Failed to find default application for content type ‘%s’"
msgstr "Нисам успео да пронађем подразумевани програм за врсту садржаја „%s“"

#: gio/gappinfo.c:1073
#, c-format
msgid "Failed to find default application for URI Scheme ‘%s’"
msgstr "Нисам успео да пронађем подразумевани програм за УРИ шему „%s“"

#: gio/gapplication.c:507
msgid "GApplication Options:"
msgstr "Могућности Г-програма:"

#: gio/gapplication.c:507
msgid "Show GApplication options"
msgstr "Показује могућности Г-програма"

#: gio/gapplication.c:552
msgid "Enter GApplication service mode (use from D-Bus service files)"
msgstr ""
"Улази у режим услуге Г-програма (користи се из датотека услуге Д-сабирнице)"

#: gio/gapplication.c:564
msgid "Override the application’s ID"
msgstr "Премошћује ИД програма"

#: gio/gapplication.c:575
msgid "Print the application version"
msgstr "Исписује издање програма"

#: gio/gapplication.c:587
msgid "Replace the running instance"
msgstr "Замени покренути примерак"

#: gio/gapplication-tool.c:47 gio/gapplication-tool.c:48 gio/gio-tool.c:230
#: gio/gresource-tool.c:497 gio/gsettings-tool.c:593
msgid "Print help"
msgstr "Прикажи помоћ"

#: gio/gapplication-tool.c:49 gio/gresource-tool.c:498 gio/gresource-tool.c:566
msgid "[COMMAND]"
msgstr "[НАРЕДБА]"

#: gio/gapplication-tool.c:51 gio/gio-tool.c:231
msgid "Print version"
msgstr "Исписује издање"

#: gio/gapplication-tool.c:52 gio/gsettings-tool.c:599
msgid "Print version information and exit"
msgstr "Исписује податке о издању и излази"

#: gio/gapplication-tool.c:55
msgid "List applications"
msgstr "Исписује програме"

#: gio/gapplication-tool.c:56
msgid "List the installed D-Bus activatable applications (by .desktop files)"
msgstr ""
"Исписује инсталиране програме који се могу покренути Д-сабирницом (према "
"датотекама радне површи)"

#: gio/gapplication-tool.c:59
msgid "Launch an application"
msgstr "Покреће програм"

#: gio/gapplication-tool.c:60
msgid "Launch the application (with optional files to open)"
msgstr "Покреће програм (са необавезним датотекама за отварање)"

#: gio/gapplication-tool.c:61
msgid "APPID [FILE…]"
msgstr "ИД_ПРОГРАМА [ДАТОТЕКА…]"

#: gio/gapplication-tool.c:63
msgid "Activate an action"
msgstr "Покреће радњу"

#: gio/gapplication-tool.c:64
msgid "Invoke an action on the application"
msgstr "Призива радњу над програмом"

#: gio/gapplication-tool.c:65
msgid "APPID ACTION [PARAMETER]"
msgstr "ИД_ПРОГРАМА РАДЊА [ПАРАМЕТАР]"

#: gio/gapplication-tool.c:67
msgid "List available actions"
msgstr "Исписује доступне радње"

#: gio/gapplication-tool.c:68
msgid "List static actions for an application (from .desktop file)"
msgstr "Исписује статичке радње за програм (из .desktop датотеке)"

#: gio/gapplication-tool.c:69 gio/gapplication-tool.c:75
msgid "APPID"
msgstr "ИД_ПРОГРАМА"

#: gio/gapplication-tool.c:74 gio/gapplication-tool.c:137 gio/gdbus-tool.c:110
#: gio/gio-tool.c:259 gio/glib-compile-resources.c:843
msgid "COMMAND"
msgstr "НАРЕДБА"

#: gio/gapplication-tool.c:74
msgid "The command to print detailed help for"
msgstr "Наредба за коју ће исписати детаљну помоћ"

#: gio/gapplication-tool.c:75
msgid "Application identifier in D-Bus format (eg: org.example.viewer)"
msgstr "Одредник програма у формату Д-сабирнице (нпр: „org.example.viewer“)"

#. Translators: commandline placeholder
#: gio/gapplication-tool.c:76 gio/glib-compile-resources.c:831
#: gio/glib-compile-resources.c:837 gio/glib-compile-resources.c:867
#: gio/gresource-tool.c:504 gio/gresource-tool.c:570
#: girepository/compiler/compiler.c:148 girepository/compiler/compiler.c:149
#: girepository/compiler/compiler.c:168 girepository/decompiler/decompiler.c:52
#: girepository/decompiler/decompiler.c:65
msgid "FILE"
msgstr "ДАТОТЕКА"

#: gio/gapplication-tool.c:76
msgid "Optional relative or absolute filenames, or URIs to open"
msgstr "Необавезни релативни или апсолутни називи датотека или УРИ-је за отварање"

#: gio/gapplication-tool.c:77
msgid "ACTION"
msgstr "РАДЊА"

#: gio/gapplication-tool.c:77
msgid "The action name to invoke"
msgstr "Назив радње за призивање"

#: gio/gapplication-tool.c:78
msgid "PARAMETER"
msgstr "ПАРАМЕТАР"

#: gio/gapplication-tool.c:78
msgid "Optional parameter to the action invocation, in GVariant format"
msgstr "Необавезни параметар за призивање радње, у формату Г-варијанта"

#: gio/gapplication-tool.c:100 gio/gresource-tool.c:535 gio/gsettings-tool.c:685
#, c-format
msgid ""
"Unknown command %s\n"
"\n"
msgstr ""
"Непозната наредба „%s“\n"
"\n"

#: gio/gapplication-tool.c:105
msgid "Usage:\n"
msgstr "Начин коришћења:\n"

#: gio/gapplication-tool.c:118 gio/gresource-tool.c:560 gio/gsettings-tool.c:720
msgid "Arguments:\n"
msgstr "Аргументи:\n"

#: gio/gapplication-tool.c:137 gio/gio-tool.c:259
msgid "[ARGS…]"
msgstr "[АРГУМЕНТИ…]"

#: gio/gapplication-tool.c:138
#, c-format
msgid "Commands:\n"
msgstr "Наредбе:\n"

#. Translators: do not translate 'help', but please translate 'COMMAND'.
#: gio/gapplication-tool.c:150
#, c-format
msgid ""
"Use “%s help COMMAND” to get detailed help.\n"
"\n"
msgstr ""
"Употреби „%s help НАРЕДБА“ за детаљну помоћ.\n"
"\n"

#: gio/gapplication-tool.c:169
#, c-format
msgid ""
"%s command requires an application id to directly follow\n"
"\n"
msgstr ""
"%s наредба захтева да одмах следи ИД програма\n"
"\n"

#: gio/gapplication-tool.c:175
#, c-format
msgid "invalid application id: “%s”\n"
msgstr "неисправан ИД програма: „%s“\n"

#. Translators: %s is replaced with a command name like 'list-actions'
#: gio/gapplication-tool.c:186
#, c-format
msgid ""
"“%s” takes no arguments\n"
"\n"
msgstr ""
"„%s“ не прихвата аргументе\n"
"\n"

#: gio/gapplication-tool.c:270
#, c-format
msgid "unable to connect to D-Bus: %s\n"
msgstr "не могу да се повежем на Д-сабирницу: %s\n"

#: gio/gapplication-tool.c:290
#, c-format
msgid "error sending %s message to application: %s\n"
msgstr "грешка слања %s поруке програму: %s\n"

#: gio/gapplication-tool.c:324
#, c-format
msgid "action name must be given after application id\n"
msgstr "назив радње мора бити дат након ИД-а програма\n"

#: gio/gapplication-tool.c:332
#, c-format
msgid ""
"invalid action name: “%s”\n"
"action names must consist of only alphanumerics, “-” and “.”\n"
msgstr ""
"неисправан назив радње: „%s“\n"
"називи радњи морају да садрже само слова и бројеве, „-“ и „.“\n"

#: gio/gapplication-tool.c:351
#, c-format
msgid "error parsing action parameter: %s\n"
msgstr "грешка обраде параметра радње: %s\n"

#: gio/gapplication-tool.c:363
#, c-format
msgid "actions accept a maximum of one parameter\n"
msgstr "радње прихватају највише један параметар\n"

#: gio/gapplication-tool.c:418
#, c-format
msgid "list-actions command takes only the application id"
msgstr "наредба „list-actions“ прихвата само ИД програма"

#: gio/gapplication-tool.c:428
#, c-format
msgid "unable to find desktop file for application %s\n"
msgstr "не могу да нађем датотеку радне површи за програм „%s“\n"

#: gio/gapplication-tool.c:473
#, c-format
msgid ""
"unrecognized command: %s\n"
"\n"
msgstr ""
"непрепозната наредба: %s\n"
"\n"

#: gio/gbufferedinputstream.c:422 gio/gbufferedinputstream.c:500
#: gio/ginputstream.c:181 gio/ginputstream.c:381 gio/ginputstream.c:651
#: gio/ginputstream.c:1056 gio/goutputstream.c:227 gio/goutputstream.c:1062
#: gio/gpollableinputstream.c:217 gio/gpollableoutputstream.c:289
#, c-format
msgid "Too large count value passed to %s"
msgstr "Превелика бројчана вредност је прослеђена у %s"

#: gio/gbufferedinputstream.c:894 gio/gbufferedoutputstream.c:579
#: gio/gdataoutputstream.c:557
msgid "Seek not supported on base stream"
msgstr "Није подржавано премотавање основног тока"

#: gio/gbufferedinputstream.c:941
msgid "Cannot truncate GBufferedInputStream"
msgstr "Не могу да скратим GBufferedInputStream"

#: gio/gbufferedinputstream.c:986 gio/ginputstream.c:1252 gio/giostream.c:321
#: gio/goutputstream.c:2224
msgid "Stream is already closed"
msgstr "Ток је већ затворен"

#: gio/gbufferedoutputstream.c:616 gio/gdataoutputstream.c:587
msgid "Truncate not supported on base stream"
msgstr "Није подржано скраћивање основног тока"

#: gio/gcancellable.c:327 gio/gdbusconnection.c:2009 gio/gdbusprivate.c:1434
#: gio/gsimpleasyncresult.c:871 gio/gsimpleasyncresult.c:897
#, c-format
msgid "Operation was cancelled"
msgstr "Радња је отказана"

#: gio/gcharsetconverter.c:272
msgid "Invalid object, not initialized"
msgstr "Неисправан објекат, није покренут"

#: gio/gcharsetconverter.c:293 gio/gcharsetconverter.c:324
msgid "Incomplete multibyte sequence in input"
msgstr "Непотпун вишебајтни низ на улазу"

#: gio/gcharsetconverter.c:330 gio/gcharsetconverter.c:339
msgid "Not enough space in destination"
msgstr "Нема довољно места у одредишту"

#: gio/gcharsetconverter.c:357 gio/gdatainputstream.c:842
#: gio/gdatainputstream.c:1276 glib/gconvert.c:358 glib/gconvert.c:790
#: glib/giochannel.c:1543 glib/giochannel.c:1585 glib/giochannel.c:2446
#: glib/gutf8.c:967 glib/gutf8.c:1424
msgid "Invalid byte sequence in conversion input"
msgstr "Неисправан низ бајтова у улазу претварања"

#: gio/gcharsetconverter.c:362 glib/gconvert.c:366 glib/gconvert.c:704
#: glib/giochannel.c:1550 glib/giochannel.c:2461
#, c-format
msgid "Error during conversion: %s"
msgstr "Грешка приликом претварања: %s"

#: gio/gcharsetconverter.c:460 gio/gsocket.c:1241
msgid "Cancellable initialization not supported"
msgstr "Није подржано покретање уз могућност отказивања"

#: gio/gcharsetconverter.c:471 glib/gconvert.c:231 glib/giochannel.c:1371
#, c-format
msgid "Conversion from character set “%s” to “%s” is not supported"
msgstr "Претварање из скупа знакова „%s“ у „%s“ није подржано"

#: gio/gcharsetconverter.c:475 glib/gconvert.c:235
#, c-format
msgid "Could not open converter from “%s” to “%s”"
msgstr "Не могу да отворим претварач из „%s“ у „%s“"

#: gio/gcontenttype-fdo.c:368
#, c-format
msgid "%s type"
msgstr "%s врста"

#: gio/gcontenttype-win32.c:199
msgid "Unknown type"
msgstr "Непозната врста"

#: gio/gcontenttype-win32.c:201
#, c-format
msgid "%s filetype"
msgstr "%s врста датотеке"

#: gio/gconverteroutputstream.c:432
msgid "Unexpected data after end of conversion"
msgstr "Неочекивани подаци након завршетка претварања"

#: gio/gcredentials.c:327
msgid "GCredentials contains invalid data"
msgstr "Г-акредитиви садрже неисправне податке"

#: gio/gcredentials.c:387 gio/gcredentials.c:682
msgid "GCredentials is not implemented on this OS"
msgstr "Г-акредитиви нису имплементирани на овом оперативном систему"

#: gio/gcredentials.c:546 gio/gcredentials.c:564
msgid "There is no GCredentials support for your platform"
msgstr "Нема подршке за Г-акредитиве на вашој платформи"

#: gio/gcredentials.c:622
msgid "GCredentials does not contain a process ID on this OS"
msgstr "Г-акредитиви не садрже ИД процеса на овом оперативном систему"

#: gio/gcredentials.c:676
msgid "Credentials spoofing is not possible on this OS"
msgstr "Лажирање акредитива није могуће на овом оперативном систему"

#: gio/gdatainputstream.c:298
msgid "Unexpected early end-of-stream"
msgstr "Неочекиван, преран крај тока"

#: gio/gdbusaddress.c:159 gio/gdbusaddress.c:231 gio/gdbusaddress.c:318
#, c-format
msgid "Unsupported key “%s” in address entry “%s”"
msgstr "Кључ „%s“ није подржан унутар адресе „%s“"

#: gio/gdbusaddress.c:172
#, c-format
msgid "Meaningless key/value pair combination in address entry “%s”"
msgstr "Бесмислена комбинација пара кључ/вредност унутар адресе „%s“"

#: gio/gdbusaddress.c:181
#, c-format
msgid ""
"Address “%s” is invalid (need exactly one of path, dir, tmpdir, or abstract "
"keys)"
msgstr ""
"Адреса „%s“ је неисправна (потребан је тачно један од кључева: path, dir, "
"tmpdir или abstract)"

#: gio/gdbusaddress.c:246 gio/gdbusaddress.c:257 gio/gdbusaddress.c:272
#: gio/gdbusaddress.c:333 gio/gdbusaddress.c:344
#, c-format
msgid "Error in address “%s” — the “%s” attribute is malformed"
msgstr "Грешка у адреси „%s“ - особина „%s“ није исправна"

#: gio/gdbusaddress.c:414 gio/gdbusaddress.c:679
#, c-format
msgid "Unknown or unsupported transport “%s” for address “%s”"
msgstr "Непознати или неподржани пренос „%s“ за адресу „%s“"

#: gio/gdbusaddress.c:458
#, c-format
msgid "Address element “%s” does not contain a colon (:)"
msgstr "Елемент адресе „%s“ не садржи двотачку (:)"

#: gio/gdbusaddress.c:467
#, c-format
msgid "Transport name in address element “%s” must not be empty"
msgstr "Назив транспорта у елементу адресе „%s“ не сме бити празан"

#: gio/gdbusaddress.c:488
#, c-format
msgid ""
"Key/Value pair %d, “%s”, in address element “%s” does not contain an equal sign"
msgstr ""
"Пар кључ/вредност %d, „%s“, у елементу адресе „%s“ не садржи знак једнакости"

#: gio/gdbusaddress.c:499
#, c-format
msgid ""
"Key/Value pair %d, “%s”, in address element “%s” must not have an empty key"
msgstr ""
"Пар кључ/вредност %d, „%s“, у елементу адресе „%s“ не сме имати празан кључ"

#: gio/gdbusaddress.c:513
#, c-format
msgid ""
"Error unescaping key or value in Key/Value pair %d, “%s”, in address element "
"“%s”"
msgstr ""
"Грешка при декодирању кључа или вредности у пару кључ/вредност %d, „%s“, у "
"елементу адресе „%s“"

#: gio/gdbusaddress.c:581
#, c-format
msgid ""
"Error in address “%s” — the unix transport requires exactly one of the keys "
"“path” or “abstract” to be set"
msgstr ""
"Грешка у адреси „%s“ - Јуниксов пренос захтева да је постављен тачно један од "
"кључева „path“ или „abstract“"

#. Translators: The first placeholder is a D-Bus connection address,
#. * the second is the literal name of an attribute in the address.
#.
#: gio/gdbusaddress.c:619 gio/gdbusaddress.c:634 gio/gdbusaddress.c:649
#, c-format
msgid "Error in address “%s” — the %s attribute is missing or malformed"
msgstr "Грешка у адреси „%s“ - особина %s недостаје или није исправна"

#: gio/gdbusaddress.c:671
msgid "Error auto-launching: "
msgstr "Грешка у самопокретању: "

#: gio/gdbusaddress.c:724
#, c-format
msgid "Error opening nonce file “%s”: %s"
msgstr "Грешка приликом отварања датотеке једнократних случајних бројева „%s“: %s"

#: gio/gdbusaddress.c:743
#, c-format
msgid "Error reading from nonce file “%s”: %s"
msgstr "Грешка при читању датотеке једнократних случајних бројева „%s“: %s"

#: gio/gdbusaddress.c:752
#, c-format
msgid "Error reading from nonce file “%s”, expected 16 bytes, got %d"
msgstr ""
"Грешка при читању датотеке једнократних случајних бројева „%s“, очекивано 16 "
"бајтова, а добијено %d"

#: gio/gdbusaddress.c:770
#, c-format
msgid "Error writing contents of nonce file “%s” to stream:"
msgstr ""
"Грешка приликом уписа садржаја датотеке једнократних случајних бројева „%s“ у "
"ток:"

#: gio/gdbusaddress.c:985
msgid "The given address is empty"
msgstr "Дата адреса је празна"

#: gio/gdbusaddress.c:1098
#, c-format
msgid "Cannot spawn a message bus when AT_SECURE is set"
msgstr "Не могу да направим сабирницу порука када је постављено „AT_SECURE“"

#: gio/gdbusaddress.c:1105
msgid "Cannot spawn a message bus without a machine-id: "
msgstr "Не могу да направим сабирницу порука без идентификације машине: "

#: gio/gdbusaddress.c:1112
#, c-format
msgid "Cannot autolaunch D-Bus without X11 $DISPLAY"
msgstr "Не могу да самопокренем Д-сабирницу без Икс-11 $DISPLAY"

#: gio/gdbusaddress.c:1154
#, c-format
msgid "Error spawning command line “%s”: "
msgstr "Грешка при покретању наредбе „%s“: "

#: gio/gdbusaddress.c:1223
#, c-format
msgid "Cannot determine session bus address (not implemented for this OS)"
msgstr ""
"Не могу да одредим адресу сабирнице сесије (није направљено за овај оперативни "
"систем)"

#: gio/gdbusaddress.c:1377 gio/gdbusconnection.c:7928
#, c-format
msgid ""
"Cannot determine bus address from DBUS_STARTER_BUS_TYPE environment variable — "
"unknown value “%s”"
msgstr ""
"Не могу да одредим адресу сабирнице из променљиве окружења "
"DBUS_STARTER_BUS_TYPE - непозната вредност „%s“"

#: gio/gdbusaddress.c:1386 gio/gdbusconnection.c:7937
msgid ""
"Cannot determine bus address because the DBUS_STARTER_BUS_TYPE environment "
"variable is not set"
msgstr ""
"Не могу да одредим адресу сабирнице јер није постављена променљива окружења "
"DBUS_STARTER_BUS_TYPE"

#: gio/gdbusaddress.c:1396
#, c-format
msgid "Unknown bus type %d"
